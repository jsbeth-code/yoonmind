<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 카카오내비 SDK(안전 운행 정보) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 차 블루투스 연결로 백그라운드에서 자동 시작할 때 GPS를 받으려면 "항상 허용"이 필요하다 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 안내 음성을 통화 채널(차 스피커)로 보낼 때 오디오 모드·SCO 전환에 필요 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 다른 앱 위에 알약 창(거리·속도·제한속도). 설정에서 사용자가 허용해야 뜬다 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 배터리 최적화 제외: Android 12+에서 백그라운드(블루투스 연결 이벤트)에서 포그라운드 서비스를 띄우기 위한 예외 조건 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- v0.16.0 보드 자동 시작: 폰을 다시 켜면 보드 검색을 다시 등록 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 테슬라 로그인 뒤 중계 Worker가 여는 주소: fsdslow://tesla?session=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fsdslow" android:host="tesla" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".HelpActivity" android:exported="false" android:label="도움말" />
        <activity android:name=".CaptureActivity" android:exported="false" />

        <service
            android:name=".DriveService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 차 블루투스 연결/해제. ACL_CONNECTED는 시스템만 보낼 수 있는 보호 브로드캐스트라 exported여도 안전하다 -->
        <receiver android:name=".BluetoothReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <!-- v0.16.0 보드 검색 결과(PendingIntent로 시스템이 보냄) -->
        <receiver android:name=".BoardScanReceiver" android:exported="false" />
        <!-- v0.16.0 재부팅·앱 업데이트 뒤 보드 검색 다시 등록(보호 브로드캐스트) -->
        <receiver android:name=".BoardBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
